

(defun whalami-genereate-serialnumber-commands (pid serialnumber)
  (interactive "sPID: \nsSerialnumber: ")
  (switch-to-buffer (get-buffer-create "*whalami-serialnumber*"))
  (erase-buffer)
  (insert "rem Erase serialnumber\n")
  (insert (format ".\\Walami.exe -v 0x1395 -p %s sendcmd CTRL 0x000000CB 0x00000003\r\n" pid))
  (insert "rem Reset device\n")
  (insert (format ".\\Walami.exe -v 0x1395 -p %s sendcmd CTRL 0x000000AF 0x00000000\r\n" pid))
  (insert "rem Get SN update status\n")
  (insert (format ".\\Walami.exe -v 0x1395 -p %s sendcmd CTRL 0x000001CB 0x00000005\r\n" pid))
  (insert "rem Start SN update\n")
  (insert (format ".\\Walami.exe -v 0x1395 -p %s sendcmd CTRL 0x000000CB 0x00000001\r\n" pid))
  (insert "rem Write SN\n")
  (let ((sn-lenght (length serialnumber)))
    (insert (format ".\\Walami.exe -v 0x1395 -p %s sendcmd CTRL 0x0000003A 0x00000003 0x00000000" pid))
    (insert (format " 0x%04x03%02x" (aref serialnumber 0) (+ (* sn-lenght 2) 2)))
    (setq-local serial-for-sequence (substring serialnumber 1))
    (if (not (= (% (length serial-for-sequence) 2) 0))
        (setq-local serial-for-sequence (concat serial-for-sequence " ")))

    (mapcar (lambda (seq) (insert (format " 0x%04x%04x" (aref seq 1) (aref seq 0)))) (seq-partition serial-for-sequence 2))
    (insert "\r\n"))
  (insert "rem Save SN\r\n")
  (insert (format ".\\Walami.exe -v 0x1395 -p %s sendcmd CTRL 0x000000CB 0x00000002\r\n" pid))
  (insert "rem Reset device\r\n")
  (insert (format ".\\Walami.exe -v 0x1395 -p %s sendcmd CTRL 0x000000AF 0x00000000\r\n" pid)))
